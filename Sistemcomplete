                ventana1_mostrar_accesos("PROCESO", "Camara iniciando")
                time.sleep(0.1)
                continue

            gris = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)

            caras = clasificador.detectMultiScale(
                gris,
                scaleFactor=1.2,
                minNeighbors=5,
                minSize=(80, 80)
            )

            if len(caras) == 0:
                reiniciar_prueba_parpadeo(estado_vida)
                ventana1_mostrar_accesos(
                    "PROCESO",
                    "Buscando rostro",
                    camara_frame=frame,
                    rostro_estado="BUSCANDO",
                )
                cv2.waitKey(1)
                continue

            caras = sorted(caras, key=lambda c: c[2] * c[3], reverse=True)
            x, y, w, h = caras[0]

            rostro = gris[y:y + h, x:x + w]
            rostro = cv2.resize(rostro, FACE_SIZE)

            try:
                id_usuario, confianza = modelo.predict(rostro)
            except Exception as e:
                registrar_evento(f"ERROR AL PREDICIR ROSTRO: {e}")
                guardar_evidencia(picam2, "ERROR_ROSTRO")
                return None

            nombre = mapa_rostros.get(str(id_usuario), f"ID_{id_usuario}")
            registrar_evento(
                f"ROSTRO DETECTADO ID={id_usuario} NOMBRE={nombre} CONF={confianza}"
            )

            if mejor_rostro is None or confianza < mejor_rostro["confianza"]:
                mejor_rostro = {
                    "id": int(id_usuario),
                    "nombre": nombre,
                    "confianza": float(confianza)
                }

            rostro_valido = confianza < FACE_THRESHOLD
            ojos_abiertos = False
            ojos_detectados = 0
            cajas_ojos = []
            parpadeo_ok = bool(estado_vida.get("ok"))
            mensaje_vida = "Mira a la camara"

            if rostro_valido and VENTANA1_REQUIERE_PARPADEO:
                ojos_abiertos, ojos_detectados, cajas_ojos = detectar_ojos_abiertos(
                    gris,
                    (x, y, w, h),
                    clasificador_ojos,
                )
                parpadeo_ok, mensaje_vida = actualizar_prueba_parpadeo(
                    estado_vida,
                    ojos_abiertos,
                    int(id_usuario),
                )
                if estado_vida.get("evento_ok"):
                    registrar_evento(f"PRUEBA DE VIDA OK POR PARPADEO: {nombre}")
                    estado_vida["evento_ok"] = False
            elif not rostro_valido:
                reiniciar_prueba_parpadeo(estado_vida)

            if confianza < 45:
                color_rostro = (255, 45, 255)
                estado_rostro = "CONOCIDO"
                texto_rostro = f"USUARIO: {nombre}"
            elif confianza < FACE_THRESHOLD:
                color_rostro = (255, 180, 35)
                estado_rostro = "CONOCIDO"
                texto_rostro = f"USUARIO: {nombre}"
            else:
                color_rostro = (45, 65, 240)
                estado_rostro = "DESCONOCIDO"
                texto_rostro = "ROSTRO DESCONOCIDO"

            if rostro_valido and VENTANA1_REQUIERE_PARPADEO and not parpadeo_ok:
                color_rostro = (255, 225, 40)
                estado_rostro = "PARPADEA"
                texto_rostro = mensaje_vida
            elif rostro_valido and parpadeo_ok:
                color_rostro = (90, 230, 90)
                estado_rostro = "VIDA OK"
                texto_rostro = f"USUARIO: {nombre}"

            _dibujar_estado(
                frame,
                x,
                y,
                w,
                h,
                color_rostro,
                texto_rostro,
                grosor=3
            )
            for ex, ey, ew, eh in cajas_ojos:
                cv2.rectangle(frame, (ex, ey), (ex + ew, ey + eh), color_rostro, 1)

            ventana1_mostrar_accesos(
                "PROCESO",
                mensaje_vida if rostro_valido else "Mira a la camara",
                camara_frame=frame,
                rostro_nombre=nombre if estado_rostro != "DESCONOCIDO" else "No identificado",
                rostro_estado=estado_rostro,
                rostro_confianza=confianza,
            )
            cv2.waitKey(1)

            if rostro_valido and parpadeo_ok:
                ventana1_guardar_rostro(
                    frame,
                    nombre=nombre,
                    estado="VERIFICADO",
                    confianza=confianza,
                )
                registrar_evento(
                    f"ROSTRO VALIDO CON VIDA ID={id_usuario} NOMBRE={nombre} "
                    f"CONF={confianza} OJOS={ojos_detectados}"
                )
                time.sleep(0.3)
                ventana1_mostrar_accesos("PROCESO", "Rostro verificado", usar_ultimo_rostro=True)
                return {
                    "id": int(id_usuario),
                    "nombre": nombre,
                    "confianza": float(confianza)
                }
            elif rostro_valido:
                time.sleep(0.08)
                continue
            else:
                registrar_evento(
                    f"ROSTRO INVALIDO ID={id_usuario} NOMBRE={nombre} CONF={confianza}"
                )
                time.sleep(0.15)
                continue
    finally:
        etapa1_ventana_activa.clear()



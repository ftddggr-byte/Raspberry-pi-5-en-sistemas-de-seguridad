                registrar_evento(f"ERROR VISTA CAMARA ETAPA 1: {e}")
                try:
                    camara.stop()
                    camara.close()
                except Exception:
                    pass
                camara = None
                time.sleep(1)
                continue

            time.sleep(0.04)

def verificar_huella():
    """
    Devuelve el finger_id si la huella es válida; None si falla.
    """
    finger_local = None
    try:
        finger_local = crear_sensor_huella()
    except Exception as e:
        registrar_evento(f"ERROR INICIANDO SENSOR DE HUELLA: {e}")
        return None

    try:
        registrar_evento("VERIFICACION DE HUELLA INICIADA")

        try:
            finger_local.read_templates()
            registrar_evento(f"PLANTILLAS EN SENSOR: {list(finger_local.templates)}")
        except Exception as e:
            registrar_evento(f"NO SE PUDIERON LEER PLANTILLAS DEL SENSOR: {e}")

        print("Coloca el dedo registrado en el sensor...")
        led_azul(finger_local)

        inicio = time.time()
        ultimo_estado = None

        while True:
            if time.time() - inicio > TIEMPO_MAX_HUELLA:
                estado_txt = nombre_estado_huella(ultimo_estado)
                registrar_evento(f"TIMEOUT EN HUELLA (ULTIMO ESTADO: {estado_txt})")
                return None

            estado = finger_local.get_image()

            if estado != ultimo_estado:
                registrar_evento(f"ESTADO SENSOR HUELLA: {nombre_estado_huella(estado)}")
                ultimo_estado = estado

            if estado != adafruit_fingerprint.OK:
                time.sleep(0.08)
                continue

            if finger_local.image_2_tz(1) != adafruit_fingerprint.OK:
                registrar_evento("ERROR AL CONVERTIR IMAGEN DE HUELLA")
                led_rojo(finger_local)
                time.sleep(TIEMPO_LED_RECHAZO)
                return None

            if finger_local.finger_search() != adafruit_fingerprint.OK:
                registrar_evento("HUELLA NO ENCONTRADA")
                led_rojo(finger_local)
                time.sleep(TIEMPO_LED_RECHAZO)
                return None

            if finger_local.confidence < UMBRAL_HUELLA:
                registrar_evento(
                    f"HUELLA BAJA CONFIANZA ID={finger_local.finger_id} CONF={finger_local.confidence}"
                )
                led_rojo(finger_local)
                time.sleep(TIEMPO_LED_RECHAZO)
                return None

            registrar_evento(
                f"HUELLA VALIDADA ID={finger_local.finger_id} CONF={finger_local.confidence}"
            )
            led_morado(finger_local)
            time.sleep(TIEMPO_LED_ACEPTACION)
            return finger_local.finger_id
    finally:
        led_apagado(finger_local)
        cerrar_sensor_huella(finger_local)



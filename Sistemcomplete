def etapa2_reconocer_rostro_vigilancia(frame_rgb):
    global etapa2_ultimo_reconocimiento
    global etapa2_rostro_nombre
    global etapa2_rostro_estado
    global etapa2_rostro_confianza

    ahora = time.time()
    if ahora - etapa2_ultimo_reconocimiento < ETAPA2_INTERVALO_RECONOCIMIENTO_ROSTRO:
        return
    etapa2_ultimo_reconocimiento = ahora

    if not etapa2_preparar_reconocimiento_facial():
        return

    try:
        gris = cv2.cvtColor(frame_rgb, cv2.COLOR_RGB2GRAY)
        caras = etapa2_clasificador_rostros.detectMultiScale(
            gris,
            scaleFactor=1.2,
            minNeighbors=5,
            minSize=(80, 80),
        )
    except Exception:
        return

    if len(caras) == 0:
        with etapa2_lock:
            etapa2_rostro_nombre = None
            etapa2_rostro_estado = None
            etapa2_rostro_confianza = None
        return

    x, y, w, h = obtener_rostro_mayor(caras)
    rostro = gris[y:y + h, x:x + w]
    try:
        rostro = cv2.resize(rostro, FACE_SIZE)
        id_usuario, confianza = etapa2_modelo_rostros.predict(rostro)
    except Exception:
        return

    nombre = etapa2_mapa_rostros.get(str(id_usuario), "DESCONOCIDO")
    reconocido = confianza < FACE_THRESHOLD and nombre != "DESCONOCIDO"
    autorizado = reconocido and usuario_tiene_autorizacion_vigente(nombre)

    if reconocido:
        estado = "AUTORIZADO" if autorizado else "NO AUTORIZADO"
        color = (0, 255, 0) if autorizado else (255, 0, 0)
        if not autorizado:
            etapa2_marcar_rostro_no_autorizado(nombre, confianza, frame_rgb)
    else:
        nombre = "DESCONOCIDO"
        estado = "NO AUTORIZADO"
        color = (255, 0, 0)

    cv2.rectangle(frame_rgb, (x, y), (x + w, y + h), color, 2)
    with etapa2_lock:
        etapa2_rostro_nombre = normalizar_nombre(nombre)
        etapa2_rostro_estado = estado
        etapa2_rostro_confianza = confianza



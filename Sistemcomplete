def obtener_rostro_mayor(caras):
    if len(caras) == 0:
        return None
    return max(caras, key=lambda c: c[2] * c[3])


def cargar_clasificador_ojos():
    for archivo in (
        "haarcascade_eye_tree_eyeglasses.xml",
        "haarcascade_eye.xml",
    ):
        ruta = cv2.data.haarcascades + archivo
        clasificador = cv2.CascadeClassifier(ruta)
        if not clasificador.empty():
            return clasificador
    return None


def detectar_ojos_abiertos(gris, cara, clasificador_ojos):
    if clasificador_ojos is None:
        return False, 0, []

    x, y, w, h = cara
    margen_x = max(4, int(w * 0.08))
    roi_x = x + margen_x
    roi_y = y + max(4, int(h * 0.18))
    roi_w = max(1, w - margen_x * 2)
    roi_h = max(1, int(h * 0.36))

    roi = gris[roi_y:roi_y + roi_h, roi_x:roi_x + roi_w]
    if roi.size == 0:
        return False, 0, []

    min_ojo_w = max(12, int(w * 0.12))
    min_ojo_h = max(8, int(h * 0.08))
    ojos = clasificador_ojos.detectMultiScale(
        roi,
        scaleFactor=1.1,
        minNeighbors=4,
        minSize=(min_ojo_w, min_ojo_h),
    )

    ojos_filtrados = []
    for ex, ey, ew, eh in ojos:
        if ew * eh < min_ojo_w * min_ojo_h:
            continue
        ojos_filtrados.append((roi_x + ex, roi_y + ey, ew, eh))

    return (
        len(ojos_filtrados) >= max(1, PARPADEO_MIN_OJOS_ABIERTOS),
        len(ojos_filtrados),
        ojos_filtrados,
    )


def reiniciar_prueba_parpadeo(estado_vida):
    estado_vida["rostro_id"] = None
    estado_vida["fase"] = "ojos_abiertos"
    estado_vida["abiertos"] = 0
    estado_vida["cerrados"] = 0
    estado_vida["ok"] = not VENTANA1_REQUIERE_PARPADEO
    estado_vida["evento_ok"] = False


def actualizar_prueba_parpadeo(estado_vida, ojos_abiertos, rostro_id):
    if estado_vida.get("rostro_id") != rostro_id:
        estado_vida["rostro_id"] = rostro_id
        estado_vida["fase"] = "ojos_abiertos"
        estado_vida["abiertos"] = 0
        estado_vida["cerrados"] = 0
        estado_vida["ok"] = False
        estado_vida["evento_ok"] = False

    if ojos_abiertos:
        estado_vida["abiertos"] += 1
        estado_vida["cerrados"] = 0
    else:
        estado_vida["cerrados"] += 1
        estado_vida["abiertos"] = 0

    if estado_vida["ok"]:
        return True, "Vida OK"

    fase = estado_vida["fase"]
    if fase == "ojos_abiertos":
        if estado_vida["abiertos"] >= PARPADEO_MIN_CUADROS_ABIERTO:
            estado_vida["fase"] = "cierra_ojos"
        return False, "Parpadea"

    if fase == "cierra_ojos":
        if estado_vida["cerrados"] >= PARPADEO_MIN_CUADROS_CERRADO:
            estado_vida["fase"] = "abre_ojos"
            return False, "Abre los ojos"
        return False, "Cierra y abre ojos"

    if fase == "abre_ojos":
        if estado_vida["abiertos"] >= PARPADEO_MIN_CUADROS_ABIERTO:
            estado_vida["ok"] = True
            estado_vida["evento_ok"] = True
            return True, "Vida OK"
        return False, "Abre los ojos"

    return False, "Parpadea"


def capturar_rostros(nombre, total=TARGET_FACES):
    nombre = normalizar_nombre(nombre)
    carpeta = os.path.join(ROSTROS_DIR, nombre)

    if os.path.exists(carpeta):
        shutil.rmtree(carpeta, ignore_errors=True)

    os.makedirs(carpeta, exist_ok=True)

    clasificador = cv2.CascadeClassifier(
        cv2.data.haarcascades + "haarcascade_frontalface_default.xml"
    )

    if clasificador.empty():
        print("No se pudo cargar el clasificador de rostros.")
        registrar_evento("ERROR CARGANDO HAAR CASCADE")
        return 0

    detener_vista_camara_etapa1()
    picam2 = crear_camara()
    if picam2 is None:
        iniciar_vista_camara_etapa1()
        return 0

    contador = 0
    ultimo_guardado = 0.0

    print("\n================================")
    print(" CAPTURA DE ROSTROS ")
    print("================================")
    print("Colócate frente a la cámara.")
    print("Presiona Q para salir.")

    ventana2_registro_activo.set()

    try:
        while contador < total:
            frame_rgb = picam2.capture_array()
            frame = cv2.cvtColor(frame_rgb, cv2.COLOR_RGB2BGR)
            gris = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)

            caras = clasificador.detectMultiScale(
                gris,
                scaleFactor=1.2,
                minNeighbors=5,
                minSize=(80, 80)
            )

            cara = obtener_rostro_mayor(caras)

            if cara is not None:
                x, y, w, h = cara
                rostro = gris[y:y + h, x:x + w]
                rostro = cv2.resize(rostro, FACE_SIZE)

                cv2.rectangle(frame, (x, y), (x + w, y + h), (80, 245, 120), 2)

                ahora = time.time()
                if ahora - ultimo_guardado >= MIN_SAMPLE_INTERVAL:
                    archivo = os.path.join(carpeta, f"rostro_{contador}.jpg")
                    cv2.imwrite(archivo, rostro)
                    contador += 1
                    ultimo_guardado = ahora
                    print(f"Rostro guardado: {contador}/{total}")

                estado = "Rostro detectado"
            else:
                estado = "Buscando rostro"

            _mostrar_panel_ventana2(
                "Captura de rostros",
                [
                    f"Usuario: {nombre}",
                    f"Capturas: {contador}/{total}",
                    estado,
                    "Mira de frente a la camara.",
                ],
                pie="Q o Esc cancelar",
                frame_base=frame,
            )
            tecla = _esperar_tecla_ventana2()
            if tecla in ("q", "Q", "*"):
                break

    finally:
        ventana2_registro_activo.clear()
        cerrar_camara(picam2)
        iniciar_vista_camara_etapa1()
        ventana2_mostrar_registros_etapa2("Captura facial finalizada")

    print(f"\nCaptura finalizada. Se guardaron {contador} rostros.")
    registrar_evento(f"CAPTURA DE ROSTROS FINALIZADA NOMBRE={nombre} CANTIDAD={contador}")
    return contador


def entrenar_lbph():
    if not os.path.exists(ROSTROS_DIR):
        print("No existe la carpeta de rostros.")
        registrar_evento("NO EXISTE CARPETA DE ROSTROS")
        return False

    if not hasattr(cv2, "face"):
        print("OpenCV no tiene cv2.face. Instala opencv-contrib-python.")
        registrar_evento("OPENCV SIN MODULO FACE")
        return False

    try:
        recognizer = cv2.face.LBPHFaceRecognizer_create()
    except Exception as e:
        print(f"No se pudo crear el reconocedor LBPH: {e}")
        registrar_evento(f"ERROR CREANDO RECONOCEDOR LBPH: {e}")
        return False

    rostros = []
    labels = []
    label_map = {}

    carpetas = [
        d for d in sorted(os.listdir(ROSTROS_DIR))
        if os.path.isdir(os.path.join(ROSTROS_DIR, d))
    ]

    label_actual = 1

    for persona in carpetas:
        carpeta_persona = os.path.join(ROSTROS_DIR, persona)
        imagenes = sorted(os.listdir(carpeta_persona))

        tiene_imagenes = False
        for archivo in imagenes:
            if not archivo.lower().endswith((".jpg", ".jpeg", ".png")):
                continue

            ruta_img = os.path.join(carpeta_persona, archivo)
            img = cv2.imread(ruta_img, cv2.IMREAD_GRAYSCALE)
            if img is None:
                continue

            if img.shape != FACE_SIZE:
                img = cv2.resize(img, FACE_SIZE)

            rostros.append(img)
            labels.append(label_actual)
            tiene_imagenes = True

        if tiene_imagenes:
            label_map[str(label_actual)] = persona
            print(f"ID LBPH {label_actual} -> {persona}")
            label_actual += 1

    if not rostros:
        print("No hay imágenes suficientes para entrenar el modelo.")
        registrar_evento("NO HAY IMAGENES PARA ENTRENAR LBPH")
        if os.path.exists(MODELO_FILE):
            try:
                os.remove(MODELO_FILE)
            except Exception:
                pass
        guardar_json(ROSTRO_IDS_FILE, {})
        return False

    print("\n================================")
    print(" ENTRENANDO MODELO LBPH ")
    print("================================")

    recognizer.train(rostros, np.array(labels))
    recognizer.write(MODELO_FILE)

    guardar_json(ROSTRO_IDS_FILE, label_map)

    usuarios = cargar_usuarios()
    for nombre, datos in usuarios.items():
        nombre_norm = normalizar_nombre(nombre)
        rostro_id = None
        for id_txt, persona in label_map.items():
            if normalizar_nombre(persona) == nombre_norm:
                rostro_id = int(id_txt)
                break
        datos["rostro_id"] = rostro_id
    guardar_usuarios(usuarios)

    print("\nMODELO ENTRENADO")
    print("Archivo:")
    print(MODELO_FILE)

    print("\nMAPEO GENERADO:")
    print(label_map)

    registrar_evento(f"MODELO LBPH ENTRENADO -> {MODELO_FILE}")
    return True



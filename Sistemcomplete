def env_int(nombre, valor_por_defecto):
    try:
        return int(os.environ.get(nombre, str(valor_por_defecto)))
    except (TypeError, ValueError):
        return valor_por_defecto


def env_bool(nombre, valor_por_defecto=False):
    valor = os.environ.get(nombre)
    if valor is None:
        return valor_por_defecto
    return valor.strip().lower() in ("1", "true", "si", "sí", "yes", "on")


def preparar_pantallas_para_thonny():
    """
    Permite ejecutar directamente desde Thonny sin usar el lanzador .sh.
    Detecta la pantalla 800x480 como pantalla de acceso y la otra como panel.
    """
    try:
        resultado = subprocess.run(
            ["xrandr", "--query"],
            check=False,
            capture_output=True,
            text=True,
            timeout=2,
        )
    except Exception:
        return

    if resultado.returncode != 0:
        return

    pantallas = []
    for linea in resultado.stdout.splitlines():
        partes = linea.split()
        if len(partes) < 3 or partes[1] != "connected":
            continue

        nombre = partes[0]
        geometria = None
        for parte in partes[2:]:
            if "x" in parte and "+" in parte:
                geometria = parte
                break

        if geometria is None:
            continue

        try:
            tamano, x_pos, y_pos = geometria.split("+", 2)
            ancho, alto = tamano.split("x", 1)
            pantallas.append({
                "nombre": nombre,
                "ancho": int(ancho),
                "alto": int(alto),
                "x": int(x_pos),
                "y": int(y_pos),
            })
        except Exception:
            continue

    if not pantallas:
        return

    acceso = None
    for pantalla in pantallas:
        if pantalla["ancho"] == 800 and pantalla["alto"] == 480:
            acceso = pantalla
            break

    if acceso is None:
        acceso = pantallas[0]

    registros = None
    for pantalla in pantallas:
        if pantalla["nombre"] != acceso["nombre"]:
            registros = pantalla
            break

    os.environ.setdefault("PANTALLA1_OUTPUT", acceso["nombre"])
    os.environ.setdefault("PANTALLA1_X", str(acceso["x"]))
    os.environ.setdefault("PANTALLA1_Y", str(acceso["y"]))
    os.environ.setdefault("PANTALLA1_W", str(acceso["ancho"]))
    os.environ.setdefault("PANTALLA1_H", str(acceso["alto"]))

    if registros is not None:
        os.environ.setdefault("PANTALLA2_OUTPUT", registros["nombre"])
        os.environ.setdefault("PANTALLA2_X", str(registros["x"]))
        os.environ.setdefault("PANTALLA2_Y", str(registros["y"]))

    rotacion = os.environ.get("PANTALLA1_ROTACION", "inverted").strip().lower()
    if rotacion in ("normal", "inverted", "left", "right"):
        try:
            subprocess.run(
                ["xrandr", "--output", acceso["nombre"], "--rotate", rotacion],
                check=False,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=2,
            )
        except Exception:
            pass


preparar_pantallas_para_thonny()


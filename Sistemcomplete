def _configurar_ventana(nombre, ancho, alto, posicion, pantalla_completa=False):
    clave = (ancho, alto, posicion[0], posicion[1], bool(pantalla_completa))
    if ventanas_configuradas.get(nombre) == clave:
        return

    flags = cv2.WINDOW_NORMAL
    if hasattr(cv2, "WINDOW_GUI_NORMAL"):
        flags |= cv2.WINDOW_GUI_NORMAL

    cv2.namedWindow(nombre, flags)
    cv2.resizeWindow(nombre, ancho, alto)
    cv2.moveWindow(nombre, posicion[0], posicion[1])
    if nombre == VENTANA_ETAPA2:
        callback = globals().get("ventana2_mouse_callback")
        if callable(callback):
            cv2.setMouseCallback(nombre, callback)
    if pantalla_completa:
        cv2.setWindowProperty(
            nombre,
            cv2.WND_PROP_FULLSCREEN,
            cv2.WINDOW_FULLSCREEN,
        )

    ventanas_configuradas[nombre] = clave


def _mostrar_frame(nombre, frame, posicion):
    try:
        pantalla_completa = (
            (nombre == VENTANA_ETAPA1 and VENTANA1_FULLSCREEN)
            or (nombre == VENTANA_ETAPA2 and VENTANA2_FULLSCREEN)

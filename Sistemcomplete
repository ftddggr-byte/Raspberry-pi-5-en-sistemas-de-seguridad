def _esperar_tecla_ventana2():
    tecla = cv2.waitKey(20) & 0xFF
    if tecla in (255,):
        return None
    if tecla in (13, 10):
        return "#"
    if tecla in (27,):
        return "*"
    if tecla in (8, 127):
        return "BORRAR"
    try:
        return chr(tecla)
    except Exception:
        return None


def limpiar_caracter_ventana2(tecla):
    if not tecla or len(tecla) != 1:
        return None

    tecla = texto_ascii(tecla)
    if not tecla or len(tecla) != 1:
        return None

    permitidos = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 _-.@"
    if tecla not in permitidos:
        return None

    return tecla.upper()



        valor_txt = str(valor)
        escala = 0.44 if len(valor_txt) > 9 else 0.62
        grosor = 1 if len(valor_txt) > 9 else 2
        _texto(frame, valor_txt, x + 14, y + h - 13, escala, color, grosor)



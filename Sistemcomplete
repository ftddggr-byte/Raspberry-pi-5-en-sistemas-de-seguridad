def etapa2_detectar_movimiento_camara(frame_rgb, frame_anterior):
    gris = cv2.cvtColor(frame_rgb, cv2.COLOR_RGB2GRAY)
    gris = cv2.GaussianBlur(gris, (21, 21), 0)

    movimiento = False

    if frame_anterior is None:
        return movimiento, gris

    diferencia = cv2.absdiff(frame_anterior, gris)
    umbral = cv2.threshold(diferencia, 25, 255, cv2.THRESH_BINARY)[1]
    umbral = cv2.dilate(umbral, None, iterations=2)

    contornos, _ = cv2.findContours(
        umbral,
        cv2.RETR_EXTERNAL,
        cv2.CHAIN_APPROX_SIMPLE,
    )

    for contorno in contornos:
        if cv2.contourArea(contorno) < ETAPA2_AREA_MINIMA:
            continue

        movimiento = True
        x, y, w, h = cv2.boundingRect(contorno)
        cv2.rectangle(frame_rgb, (x, y), (x + w, y + h), (0, 255, 0), 2)

    return movimiento, gris



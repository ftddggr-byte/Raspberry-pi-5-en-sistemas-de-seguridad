def pedir_password(tipo_password="usuario", nombre_usuario=None):
    """
    Solicita contraseña por teclado matricial.
    '*' borra, '#' confirma.
    """
    entrada = ""
    inicio = time.time()
    tipo_password = str(tipo_password or "usuario").upper()
    nombre_usuario = normalizar_nombre(nombre_usuario) if nombre_usuario else ""
    encabezado = f"Password {tipo_password}"
    if nombre_usuario:
        encabezado = f"{nombre_usuario[:10]} {tipo_password}"

    registrar_evento(f"INGRESO DE PASSWORD {tipo_password} INICIADO")
    ventana1_mostrar_accesos("PROCESO", f"{encabezado}: _", usar_ultimo_rostro=True)

    while True:
        if time.time() - inicio > TIEMPO_MAX_PASSWORD:
            registrar_evento("TIMEOUT EN PASSWORD")
            ventana1_mostrar_accesos("DENEGADO", "Timeout password", usar_ultimo_rostro=True)
            return None

        tecla = leer_tecla()
        if tecla is None:
            cv2.waitKey(1)
            continue

        if tecla == '*':
            entrada = ""
            print("PASSWORD BORRADA")
            registrar_evento("PASSWORD BORRADA")
            ventana1_mostrar_accesos("PROCESO", f"{encabezado}: _", usar_ultimo_rostro=True)

        elif tecla == '#':
            if len(entrada) < MIN_CARACTERES:
                print("========================")
                print(" PASSWORD MUY CORTA ")
                print("========================")
                registrar_evento("PASSWORD MUY CORTA")
                ventana1_mostrar_accesos("DENEGADO", "Password muy corta", usar_ultimo_rostro=True)
                return None

            registrar_evento("PASSWORD INGRESADA")
            return entrada

        else:
            entrada += tecla
            print("Password:", "*" * len(entrada))
            ventana1_mostrar_accesos(
                "PROCESO",
                f"{encabezado}: " + ("*" * len(entrada)),
                usar_ultimo_rostro=True,
            )

            if len(entrada) > MAX_CARACTERES:
                print("========================")
                print(" MAXIMO 8 CARACTERES ")
                print("========================")
                registrar_evento("PASSWORD EXCEDIO MAXIMO")
                ventana1_mostrar_accesos("DENEGADO", "Maximo 8 caracteres", usar_ultimo_rostro=True)
                return None



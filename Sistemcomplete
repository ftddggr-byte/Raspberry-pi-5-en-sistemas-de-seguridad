def _ajustar_frame(frame, ancho, alto):
    if frame is None:
        return None
    try:
        return cv2.resize(frame, (ancho, alto))
    except Exception:
        return None


def _color_rostro(rostro_estado=None, rostro_confianza=None):
    estado = str(rostro_estado or "").upper()
    if estado == "DESCONOCIDO":
        return (45, 65, 240)
    if estado == "BUSCANDO":
        return (255, 170, 40)
    if estado in ("PARPADEA", "ANTIFRAUDE"):
        return (255, 225, 40)
    if estado in ("VIDA OK", "VERIFICADO"):
        return (90, 230, 90)

    if rostro_confianza is not None:
        try:
            confianza = float(rostro_confianza)
            if confianza < 45:
                return (255, 45, 255)
            if confianza < FACE_THRESHOLD:
                return (255, 180, 35)
        except Exception:
            pass

    if estado in ("CONOCIDO", "VERIFICADO"):
        return (255, 45, 255)
    return (90, 100, 115)



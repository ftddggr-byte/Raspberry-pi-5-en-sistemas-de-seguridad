def etapa3_valor_gpio(activo):
    if ETAPA3_RELE_ACTIVO_BAJO:
        return 0 if activo else 1
    return 1 if activo else 0


def etapa3_escribir(gpio, activo):
    lgpio.gpio_write(h_gpio, gpio, etapa3_valor_gpio(activo))


def etapa3_iniciar_relevadores():
    global etapa3_relevadores_iniciados

    if not ETAPA3_USAR_RELEVADORES or etapa3_relevadores_iniciados:
        return

    valor_apagado = etapa3_valor_gpio(False)
    for gpio in (ETAPA3_GPIO_RELE_ACCESO, ETAPA3_GPIO_RELE_ALARMA):
        try:
            lgpio.gpio_claim_output(h_gpio, gpio, valor_apagado)
        except Exception as e:
            registrar_evento(f"ETAPA 3 ERROR CONFIGURANDO GPIO{gpio}: {e}")
            try:
                lgpio.gpio_write(h_gpio, gpio, valor_apagado)
            except Exception:
                pass

    etapa3_relevadores_iniciados = True
    registrar_evento(
        "ETAPA 3 RELEVADORES LISTOS "
        f"ACCESO=GPIO{ETAPA3_GPIO_RELE_ACCESO} "
        f"ALARMA=GPIO{ETAPA3_GPIO_RELE_ALARMA} "
        f"ACTIVO_BAJO={ETAPA3_RELE_ACTIVO_BAJO}"
    )


def etapa3_apagar_relevadores():
    if not ETAPA3_USAR_RELEVADORES:
        return

    for gpio in (ETAPA3_GPIO_RELE_ACCESO, ETAPA3_GPIO_RELE_ALARMA):
        try:
            etapa3_escribir(gpio, False)
        except Exception:
            pass


def etapa3_pulso(gpio, segundos, nombre, lock):
    if not ETAPA3_USAR_RELEVADORES:
        return

    etapa3_iniciar_relevadores()

    if not lock.acquire(blocking=False):
        registrar_evento_silencioso(f"ETAPA 3 {nombre} YA ESTABA ACTIVO")
        return

    try:
        registrar_evento(f"ETAPA 3 {nombre} ON {segundos:.1f}s")
        etapa3_escribir(gpio, True)
        time.sleep(segundos)
    except Exception as e:
        registrar_evento(f"ETAPA 3 ERROR EN {nombre}: {e}")
    finally:
        try:
            etapa3_escribir(gpio, False)
            registrar_evento_silencioso(f"ETAPA 3 {nombre} OFF")
        except Exception:
            pass
        lock.release()


def etapa3_abrir_puerta(origen="etapa1"):
    registrar_evento(f"ETAPA 3 APERTURA SOLICITADA POR {origen}")
    etapa3_pulso(
        ETAPA3_GPIO_RELE_ACCESO,
        ETAPA3_TIEMPO_APERTURA,
        "RELE 1 ACCESO",
        etapa3_lock_acceso,
    )


def etapa3_activar_alarma(origen="etapa2"):
    def ejecutar():
        registrar_evento(f"ETAPA 3 ALARMA SOLICITADA POR {origen}")

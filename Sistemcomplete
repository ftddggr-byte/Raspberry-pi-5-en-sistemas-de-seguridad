def nombre_estado_huella(codigo):
    estados = [
        ("OK", "OK"),
        ("NOFINGER", "SIN_DEDO"),
        ("IMAGEFAIL", "ERROR_IMAGEN"),
        ("IMAGEMESS", "IMAGEN_SUCIA"),
        ("FEATUREFAIL", "SIN_RASGOS"),
        ("INVALIDIMAGE", "IMAGEN_INVALIDA"),
        ("PACKETRECIEVEERR", "ERROR_COMUNICACION"),
        ("BADPACKET", "PAQUETE_INVALIDO"),
        ("NOTFOUND", "NO_ENCONTRADA"),
    ]

    for constante, nombre in estados:
        valor = getattr(adafruit_fingerprint, constante, None)
        if valor is not None and codigo == valor:
            return nombre

    return f"CODIGO_{codigo}"



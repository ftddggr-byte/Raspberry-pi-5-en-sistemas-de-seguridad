keys = [
    ['1', '2', '3', 'A'],
    ['4', '5', '6', 'B'],
    ['7', '8', '9', 'C'],
    ['*', '0', '#', 'D']
]

ROWS = [26, 19, 13, 6]
COLS = [5, 22, 27, 17]
TECLADO_DEBOUNCE_SEG = 0.035
TECLADO_POST_TECLA_SEG = 0.18

h_gpio = lgpio.gpiochip_open(0)

for row in ROWS:
    lgpio.gpio_claim_output(h_gpio, row, 1)

for col in COLS:
    lgpio.gpio_claim_input(h_gpio, col, lgpio.SET_PULL_UP)

def leer_tecla():
    """
    Lee una tecla del teclado matricial.
    """
    for i, row in enumerate(ROWS):
        for r in ROWS:
            lgpio.gpio_write(h_gpio, r, 1)

        lgpio.gpio_write(h_gpio, row, 0)

        for j, col in enumerate(COLS):
            if lgpio.gpio_read(h_gpio, col) == 0:
                time.sleep(TECLADO_DEBOUNCE_SEG)
                if lgpio.gpio_read(h_gpio, col) != 0:
                    continue

                tecla = keys[i][j]

                while lgpio.gpio_read(h_gpio, col) == 0:
                    time.sleep(0.01)

                time.sleep(TECLADO_POST_TECLA_SEG)
                return tecla

    return None


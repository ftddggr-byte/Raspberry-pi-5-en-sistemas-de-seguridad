def listar_usuarios(usuarios):
    if not usuarios:
        print("\nNo hay usuarios registrados.")
        return []

    nombres = sorted(usuarios.keys())

    print("\n================================")
    print(" USUARIOS REGISTRADOS ")
    print("================================")
    for i, nombre in enumerate(nombres, start=1):
        datos = usuarios[nombre]
        estado = "ACTIVO" if datos.get("activo", True) else "INACTIVO"
        huella = datos.get("huella_id", None)
        rostro = datos.get("rostro_id", None)
        tipo = datos.get("tipo", "usuario").upper()
        print(f"{i}. {nombre} | {tipo} | {estado} | huella: {huella} | rostro: {rostro}")

    return nombres


def seleccionar_usuario(usuarios, titulo="Seleccione un usuario (número o nombre): "):
    nombres = listar_usuarios(usuarios)
    if not nombres:
        return None

    valor = input(f"\n{titulo}").strip()
    if not valor:
        return None

    if valor.isdigit():
        idx = int(valor)
        if 1 <= idx <= len(nombres):
            return nombres[idx - 1]

    valor_norm = normalizar_nombre(valor)
    for nombre in nombres:
        if normalizar_nombre(nombre) == valor_norm:
            return nombre

    return None


def obtener_usuario_por_huella_id(usuarios, huella_id):
    try:
        huella_buscada = int(huella_id)
    except Exception:
        return None, None

    for nombre, datos in usuarios.items():
        huella_usuario = datos.get("huella_id", None)
        if huella_usuario in (None, ""):
            continue

        try:
            if int(huella_usuario) == huella_buscada:
                return nombre, datos
        except Exception:
            continue

    return None, None


def obtener_usuario_por_rostro_id(usuarios, rostro_id, mapa_rostros):
    nombre_mapa = mapa_rostros.get(str(rostro_id), None)
    if nombre_mapa is None:
        return None, None

    nombre_norm = normalizar_nombre(nombre_mapa)
    for nombre, datos in usuarios.items():
        if normalizar_nombre(nombre) == nombre_norm:
            return nombre, datos
    return None, None


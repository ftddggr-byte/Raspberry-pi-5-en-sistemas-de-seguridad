def etapa2_registrar_sensor(sensor):
    global etapa2_primer_sensor
    global etapa2_tiempo_primer_sensor

    ahora = time.time()

    with etapa2_lock:
        if (
            etapa2_primer_sensor is not None
            and ahora - etapa2_tiempo_primer_sensor > ETAPA2_TIEMPO_MAXIMO_SECUENCIA
        ):
            etapa2_primer_sensor = None

        if etapa2_primer_sensor is None:
            etapa2_primer_sensor = sensor
            etapa2_tiempo_primer_sensor = ahora
            return

        if etapa2_primer_sensor == sensor:
            return

        secuencia = (etapa2_primer_sensor, sensor)
        etapa2_primer_sensor = None

    if secuencia == ("AFUERA", "ADENTRO"):
        etapa2_registrar_entrada_sensor()
    elif secuencia == ("ADENTRO", "AFUERA"):
        etapa2_registrar_salida_sensor()



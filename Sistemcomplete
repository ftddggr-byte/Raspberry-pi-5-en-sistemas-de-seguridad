def texto_ascii(texto):
    texto = str(texto)
    texto = unicodedata.normalize("NFKD", texto)
    texto = texto.encode("ascii", "ignore").decode("ascii")
    return texto


def _texto(frame, texto, x, y, escala=0.7, color=(255, 255, 255), grosor=2):
    cv2.putText(
        frame,
        texto_ascii(texto),
        (x, y),
        cv2.FONT_HERSHEY_SIMPLEX,
        escala,
        color,
        grosor,
        cv2.LINE_AA,
    )


def _tiempo_legible(segundos):
    try:
        segundos = max(0, int(round(float(segundos or 0))))
    except Exception:
        segundos = 0

    horas = segundos // 3600
    minutos = (segundos % 3600) // 60
    seg = segundos % 60

    if horas > 0:
        return f"{horas}h {minutos:02d}m"
    if minutos > 0:
        return f"{minutos}m {seg:02d}s"
    return f"{seg}s"


def _rect(frame, x, y, w, h, fondo, borde=None, grosor=1):
    cv2.rectangle(frame, (x, y), (x + w, y + h), fondo, -1)
    if borde is not None:
        cv2.rectangle(frame, (x, y), (x + w, y + h), borde, grosor)


def _tarjeta(frame, x, y, w, h, titulo=None, valor=None, color=(255, 150, 20)):
    _rect(frame, x, y, w, h, (44, 32, 24), (112, 82, 58), 1)
    if h < 55 and titulo is not None and valor is not None:
        _texto(frame, titulo, x + 14, y + h // 2 + 7, 0.43, (238, 242, 248), 1)
        _texto(frame, valor, x + w - 58, y + h // 2 + 8, 0.56, color, 2)

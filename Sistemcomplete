def ventana2_seleccionar_lista(titulo, opciones, pie="W/S mover  Enter seleccionar  Esc cancelar"):
    if not opciones:
        ventana2_esperar_continuar(titulo, ["No hay elementos para seleccionar."])
        return None

    seleccionado = 0
    while True:
        inicio = max(0, min(seleccionado - 5, max(0, len(opciones) - 12)))
        visibles = []
        for idx in range(inicio, min(len(opciones), inicio + 12)):
            marca = ">" if idx == seleccionado else " "
            visibles.append(f"{marca} {idx + 1}. {opciones[idx]}")

        _mostrar_panel_ventana2(titulo, visibles, pie=pie)
        tecla = _esperar_tecla_ventana2()
        if tecla in ("A", "a", "w", "W"):
            seleccionado = (seleccionado - 1) % len(opciones)
        elif tecla in ("B", "b", "s", "S"):
            seleccionado = (seleccionado + 1) % len(opciones)
        elif tecla == "#":
            return seleccionado
        elif tecla == "*":
            return None
        elif tecla and tecla.isdigit():
            valor = int(tecla)
            if valor == 0:
                valor = 10
            if 1 <= valor <= len(opciones):
                return valor - 1


def seleccionar_opcion_menu_registro():
    global ventana2_click_opcion

    opcion = 1
    total_opciones = 10
    ventana2_click_opcion = None
    ultimo_dibujo = 0.0
    while True:
        ahora = time.time()
        if ahora - ultimo_dibujo >= 0.08:
            frame = _base_etapa2_para_display()
            lienzo = _componer_ventana2(
                frame,
                encabezado="REGISTROS + ETAPA 2",
                mensaje="Click, numeros o Enter",
                opcion_activa=opcion,
            )
            _mostrar_frame(VENTANA_ETAPA2, lienzo, VENTANA_ETAPA2_POS)
            ultimo_dibujo = ahora

        tecla_matricial = leer_tecla()
        if tecla_matricial == "#":
            ventana2_click_opcion = None
            return VENTANA2_SOLICITAR_ACCESO

        if ventana2_click_opcion is not None:
            opcion = ventana2_click_opcion
            ventana2_click_opcion = None
            return str(opcion)

        tecla = _esperar_tecla_ventana2()
        if tecla is None:
            continue
        if tecla in ("A", "a", "w", "W"):
            opcion = total_opciones if opcion == 1 else opcion - 1
            ultimo_dibujo = 0.0
        elif tecla in ("B", "b", "s", "S"):
            opcion = 1 if opcion == total_opciones else opcion + 1
            ultimo_dibujo = 0.0
        elif tecla in ("#", "\r", "\n"):
            return str(opcion)
        elif tecla == "*":
            return None
        elif tecla and tecla.isdigit():
            return "10" if tecla == "0" else tecla



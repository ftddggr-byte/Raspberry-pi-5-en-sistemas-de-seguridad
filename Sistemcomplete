def cargar_json(ruta, valor_por_defecto):
    try:
        with open(ruta, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        if isinstance(valor_por_defecto, dict):
            return valor_por_defecto.copy()
        if isinstance(valor_por_defecto, list):
            return valor_por_defecto.copy()
        return valor_por_defecto


def guardar_json(ruta, datos):
    os.makedirs(os.path.dirname(ruta), exist_ok=True)
    with open(ruta, "w", encoding="utf-8") as f:
        json.dump(datos, f, indent=4, ensure_ascii=False)


def _detalle_json(detalle):
    if detalle is None:
        return {}

    try:
        json.dumps(detalle)
        return detalle
    except TypeError:
        return {"valor": str(detalle)}


def cargar_permisos_etapa1():
    datos = cargar_json(PERMISOS_ETAPA1_FILE, {})

    if not isinstance(datos, dict):
        datos = {}

    datos.setdefault("pendientes", [])
    datos.setdefault("historial", [])
    datos.setdefault("ultimo_permiso", None)
    datos.setdefault("permiso_visual", None)
    datos.setdefault("autorizaciones", {})
    datos.setdefault("por_fecha", {})

    return datos


def guardar_permisos_etapa1(datos):
    guardar_json(PERMISOS_ETAPA1_FILE, datos)


def limpiar_permisos_vencidos(datos=None):
    if datos is None:
        datos = cargar_permisos_etapa1()

    ahora = time.time()
    pendientes = []
    historial = datos.get("historial", [])

    for permiso in datos.get("pendientes", []):
        if float(permiso.get("vence_epoch", 0)) >= ahora:
            pendientes.append(permiso)
        else:
            permiso = permiso.copy()
            permiso["estado"] = "vencido"
            permiso["vencido_en"] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            historial.append(permiso)

    datos["pendientes"] = pendientes
    datos["historial"] = historial[-MAX_HISTORIAL_PERMISOS:]

    permiso_visual = datos.get("permiso_visual")
    if isinstance(permiso_visual, dict):
        permiso_visual = permiso_visual.copy()
        if float(permiso_visual.get("vence_epoch", 0) or 0) < ahora:
            permiso_visual["activo"] = False
            permiso_visual["estado"] = "vencido"
        datos["permiso_visual"] = permiso_visual

    autorizaciones = {}
    for usuario, autorizacion in (datos.get("autorizaciones") or {}).items():
        if not isinstance(autorizacion, dict):
            continue
        if float(autorizacion.get("vence_epoch", 0) or 0) >= ahora:
            autorizaciones[normalizar_nombre(usuario)] = autorizacion
    datos["autorizaciones"] = autorizaciones

    return datos


def usuario_tiene_autorizacion_vigente(nombre_usuario, datos=None):
    if not nombre_usuario:
        return False

    if datos is None:
        datos = limpiar_permisos_vencidos(cargar_permisos_etapa1())

    nombre_usuario = normalizar_nombre(nombre_usuario)
    autorizacion = (datos.get("autorizaciones") or {}).get(nombre_usuario)
    if not isinstance(autorizacion, dict):
        return False

    return float(autorizacion.get("vence_epoch", 0) or 0) >= time.time()


def contar_accesos_vigentes_desde_historial():
    ahora = time.time()
    total = 0
    usuarios = set()

    try:
        conteo = cargar_conteo_accesos()
    except Exception:
        return 0, []

    for acceso in conteo.get("historial", []):
        try:
            fecha_hora = datetime.strptime(
                str(acceso.get("fecha_hora", "")),
                "%Y-%m-%d %H:%M:%S",
            )
        except Exception:
            continue

        if ahora - fecha_hora.timestamp() > TIEMPO_PERMISO_ETAPA1:
            continue

        total += int(acceso.get("cantidad", 1) or 1)
        usuario = acceso.get("usuario")
        if usuario:
            usuarios.add(normalizar_nombre(usuario))

    return total, sorted(usuarios)


def usuario_tiene_acceso_vigente_en_historial(nombre_usuario):
    if not nombre_usuario:
        return False

    nombre_usuario = normalizar_nombre(nombre_usuario)
    ahora = time.time()

    try:
        conteo = cargar_conteo_accesos()
    except Exception:
        return False

    for acceso in reversed(conteo.get("historial", [])):
        usuario = acceso.get("usuario")
        if normalizar_nombre(usuario or "") != nombre_usuario:
            continue

        try:
            fecha_hora = datetime.strptime(
                str(acceso.get("fecha_hora", "")),
                "%Y-%m-%d %H:%M:%S",
            )
        except Exception:
            continue

        if ahora - fecha_hora.timestamp() <= TIEMPO_PERMISO_ETAPA1:
            return True

    return False



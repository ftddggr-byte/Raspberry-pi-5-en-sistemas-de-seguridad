def _color_estado_acceso(estado, detalle=None):
    estado = str(estado or "").upper()
    detalle = str(detalle or "").lower()

    if estado == "AUTORIZADO":
        return (90, 230, 90)
    if estado == "DENEGADO":
        return (45, 65, 240)
    if "password" in detalle:
        return (255, 90, 190)
    if "rostro" in detalle or "camara" in detalle:
        return (255, 225, 40)
    return (255, 150, 20)


def _paso_actual_acceso(detalle=None, estado=None):
    texto = f"{estado or ''} {detalle or ''}".lower()
    if "password" in texto:
        return "password"
    if "rostro" in texto or "camara" in texto:
        return "rostro"
    if "huella" in texto:
        return "huella"
    return "huella"



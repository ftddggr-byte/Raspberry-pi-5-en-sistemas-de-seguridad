def obtener_resumen_permisos_etapa1(cache_segundos=0.5):
    ahora = time.time()
    if ahora - permisos_resumen_cache["ts"] < cache_segundos:
        return permisos_resumen_cache["datos"].copy()

    datos = limpiar_permisos_vencidos(cargar_permisos_etapa1())
    guardar_permisos_etapa1(datos)

    pendientes = datos.get("pendientes", [])
    ultimo = datos.get("ultimo_permiso") or {}
    permiso_visual = datos.get("permiso_visual") or {}
    autorizaciones = datos.get("autorizaciones") or {}

    ultimo_vence = float(ultimo.get("vence_epoch", 0) or 0)
    ultimo_vigente = ultimo_vence >= ahora

    visual_vence = float(permiso_visual.get("vence_epoch", 0) or 0)
    visual_vigente = (
        bool(permiso_visual.get("activo"))
        and visual_vence >= ahora
    )

    usuarios_activos = []
    permisos_vigentes_total = 0
    for usuario, autorizacion in autorizaciones.items():
        if not isinstance(autorizacion, dict):
            continue
        vence_usuario = float(autorizacion.get("vence_epoch", 0) or 0)
        if vence_usuario >= ahora:
            usuario_norm = normalizar_nombre(usuario)
            usuarios_activos.append(usuario_norm)
            permisos_vigentes_total += max(1, int(autorizacion.get("accesos", 1) or 1))

    usuarios_activos = sorted(set(usuarios_activos))
    usuarios_activos_total = len(usuarios_activos)
    vencimientos = []
    for usuario in usuarios_activos:
        autorizacion = autorizaciones.get(usuario) or {}
        vence_usuario = float(autorizacion.get("vence_epoch", 0) or 0)
        if vence_usuario >= ahora:
            vencimientos.append(vence_usuario)

    vence_en = (
        max(0, int(round(max(vencimientos) - ahora)))
        if vencimientos
        else 0
    )

    fecha_hoy = datetime.now().strftime("%Y-%m-%d")
    otorgados_hoy = int(datos.get("por_fecha", {}).get(fecha_hoy, 0) or 0)

    try:
        conteo_accesos = cargar_conteo_accesos()
        accesos_hoy = int(conteo_accesos.get("por_fecha", {}).get(fecha_hoy, 0) or 0)
        otorgados_hoy = max(otorgados_hoy, accesos_hoy)
    except Exception:
        pass

    if otorgados_hoy <= 0:
        permisos_contados = set()
        permisos_revisar = list(pendientes) + list(datos.get("historial", []))
        if ultimo:
            permisos_revisar.append(ultimo)

        for permiso in permisos_revisar:
            permiso_id = permiso.get("id")
            if not permiso_id:
                permiso_id = (
                    str(permiso.get("creado_en", "")),
                    str(permiso.get("usuario", "")),
                    str(permiso.get("metodo", "")),
                )
            if permiso_id in permisos_contados:
                continue
            permisos_contados.add(permiso_id)

            creado = str(permiso.get("creado_en", ""))
            if creado.startswith(fecha_hoy):
                otorgados_hoy += int(permiso.get("cantidad", 1) or 1)

    permiso_vigente = permisos_vigentes_total > 0
    vigentes = permisos_vigentes_total

    resumen = {
        "activos": vigentes,
        "pendientes": len(pendientes),
        "vigentes": vigentes,
        "otorgados_hoy": otorgados_hoy,
        "ultimo_vigente": permiso_vigente,
        "vence_en": vence_en,
        "usuarios_activos": usuarios_activos,
        "ultimo_usuario": permiso_visual.get("usuario") or ultimo.get("usuario"),
        "ultimo_estado": "vigente" if visual_vigente else ultimo.get("estado", "pendiente"),
    }

    permisos_resumen_cache["ts"] = ahora
    permisos_resumen_cache["datos"] = resumen
    return resumen.copy()


def registrar_permiso_etapa1(
    cantidad=1,
    metodo="etapa1",
    usuario=None,
    detalle=None,
    contar_acceso=True
):
    cantidad = max(1, int(cantidad))
    detalle = _detalle_json(detalle)
    ahora_dt = datetime.now()
    ahora = ahora_dt.strftime("%Y-%m-%d %H:%M:%S")
    fecha = ahora_dt.strftime("%Y-%m-%d")
    vence_epoch = time.time() + TIEMPO_PERMISO_ETAPA1
    vence_texto = datetime.fromtimestamp(vence_epoch).strftime("%Y-%m-%d %H:%M:%S")

    acceso = {
        "fecha_hora": ahora,
        "fecha": fecha,
        "cantidad": cantidad,
        "metodo": metodo,
        "usuario": usuario,
        "detalle": detalle
    }

    if contar_acceso:
        conteo = cargar_conteo_accesos()
        conteo["total"] = int(conteo.get("total", 0)) + cantidad
        conteo.setdefault("por_fecha", {})
        conteo.setdefault("por_usuario", {})
        conteo.setdefault("por_metodo", {})
        conteo.setdefault("historial", [])

        conteo["por_fecha"][fecha] = int(conteo["por_fecha"].get(fecha, 0)) + cantidad
        conteo["por_metodo"][metodo] = int(conteo["por_metodo"].get(metodo, 0)) + cantidad

        usuario_clave = usuario or "sin_usuario"
        conteo["por_usuario"][usuario_clave] = (
            int(conteo["por_usuario"].get(usuario_clave, 0)) + cantidad
        )

        acceso["total"] = conteo["total"]
        acceso["total_hoy"] = conteo["por_fecha"][fecha]
        acceso["total_usuario"] = conteo["por_usuario"][usuario_clave]
        conteo["ultimo_acceso"] = acceso
        conteo["historial"].append(acceso)
        conteo["historial"] = conteo["historial"][-MAX_HISTORIAL_ACCESOS:]
        guardar_json(CONTEO_ACCESOS_FILE, conteo)

    permisos = limpiar_permisos_vencidos()
    permisos.setdefault("por_fecha", {})
    permisos.setdefault("autorizaciones", {})
    permisos["por_fecha"][fecha] = int(permisos["por_fecha"].get(fecha, 0)) + cantidad
    usuario_clave = normalizar_nombre(usuario or "SIN_USUARIO")

    permiso_visual = {
        "activo": True,
        "estado": "vigente",
        "creado_en": ahora,
        "vence_en": vence_texto,
        "vence_epoch": vence_epoch,
        "metodo": metodo,
        "usuario": usuario,
        "cantidad": cantidad,
        "detalle": detalle,
    }

    autorizacion_anterior = permisos["autorizaciones"].get(usuario_clave, {})
    permisos["autorizaciones"][usuario_clave] = {
        "usuario": usuario_clave,
        "estado": "vigente",
        "creado_en": autorizacion_anterior.get("creado_en", ahora),
        "actualizado_en": ahora,
        "vence_en": vence_texto,
        "vence_epoch": vence_epoch,
        "metodo": metodo,
        "accesos": int(autorizacion_anterior.get("accesos", 0) or 0) + cantidad,
        "detalle": detalle,
    }

    for indice in range(cantidad):
        permiso = {
            "id": f"{time.time_ns()}_{indice}",
            "creado_en": ahora,
            "vence_en": vence_texto,
            "vence_epoch": vence_epoch,
            "metodo": metodo,
            "usuario": usuario_clave,
            "detalle": detalle,
            "estado": "pendiente"
        }
        permisos["pendientes"].append(permiso)
        permisos["ultimo_permiso"] = permiso

    permisos["permiso_visual"] = permiso_visual
    guardar_permisos_etapa1(permisos)
    permisos_resumen_cache["ts"] = 0

    actualizar_visible = globals().get("etapa2_actualizar_permiso_visible")
    if callable(actualizar_visible):
        actualizar_visible(
            vence_epoch=vence_epoch,
            usuario=usuario,
            cantidad=cantidad,
            sumar_hoy=True,
        )

    return permisos["ultimo_permiso"]


def consumir_permiso_etapa1():
    permisos = limpiar_permisos_vencidos()
    pendientes = permisos.get("pendientes", [])

    if not pendientes:
        guardar_permisos_etapa1(permisos)
        return None

    permiso = pendientes.pop(0)
    permiso = permiso.copy()
    permiso["estado"] = "consumido"
    permiso["consumido_en"] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    permisos["pendientes"] = pendientes
    if (permisos.get("ultimo_permiso") or {}).get("id") == permiso.get("id"):
        permisos["ultimo_permiso"] = permiso
    permisos["historial"].append(permiso)
    permisos["historial"] = permisos["historial"][-MAX_HISTORIAL_PERMISOS:]
    guardar_permisos_etapa1(permisos)
    permisos_resumen_cache["ts"] = 0

    actualizar_visible = globals().get("etapa2_actualizar_permiso_visible")
    if callable(actualizar_visible):
        actualizar_visible(
            vence_epoch=float(permiso.get("vence_epoch", 0) or 0),
            usuario=permiso.get("usuario"),
            cantidad=int(permiso.get("cantidad", 1) or 1),
            sumar_hoy=False,
        )

    return permiso


def descontar_autorizacion_por_salida(nombre_usuario=None):
    permisos = limpiar_permisos_vencidos(cargar_permisos_etapa1())
    autorizaciones = permisos.setdefault("autorizaciones", {})
    ahora = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    objetivo = normalizar_nombre(nombre_usuario) if nombre_usuario else None

    def autorizacion_activa(autorizacion):
        if not isinstance(autorizacion, dict):
            return False
        if int(autorizacion.get("accesos", 0) or 0) <= 0:
            return False
        return float(autorizacion.get("vence_epoch", 0) or 0) >= time.time()

    if objetivo not in autorizaciones or not autorizacion_activa(autorizaciones.get(objetivo)):
        objetivo = None
        candidatos = []
        for usuario, autorizacion in autorizaciones.items():
            if not autorizacion_activa(autorizacion):
                continue
            marca = str(
                autorizacion.get("creado_en")
                or autorizacion.get("actualizado_en")
                or ""
            )
            candidatos.append((marca, usuario))

        if candidatos:
            candidatos.sort()
            objetivo = candidatos[0][1]

    if not objetivo:
        guardar_permisos_etapa1(permisos)
        permisos_resumen_cache["ts"] = 0
        registrar_evento("SALIDA SIN AUTORIZACION ACTIVA PARA DESCONTAR")
        return None

    autorizacion = dict(autorizaciones.get(objetivo) or {})
    accesos_restantes = max(0, int(autorizacion.get("accesos", 0) or 0) - 1)

    if accesos_restantes <= 0:
        autorizaciones.pop(objetivo, None)
    else:
        autorizacion["accesos"] = accesos_restantes
        autorizacion["actualizado_en"] = ahora
        autorizacion["ultima_salida_en"] = ahora
        autorizaciones[objetivo] = autorizacion

    permisos["autorizaciones"] = autorizaciones

    if not autorizaciones:
        permiso_visual = permisos.get("permiso_visual")
        if isinstance(permiso_visual, dict):
            permiso_visual = permiso_visual.copy()
            permiso_visual["activo"] = False
            permiso_visual["estado"] = "sin_personas_dentro"
            permiso_visual["salida_en"] = ahora
            permisos["permiso_visual"] = permiso_visual

    guardar_permisos_etapa1(permisos)
    permisos_resumen_cache["ts"] = 0
    registrar_evento(f"AUTORIZACION DESCONTADA POR SALIDA: {objetivo}")
    return objetivo


def normalizar_nombre(nombre):
    nombre = " ".join(str(nombre).strip().split()).upper()
    nombre = nombre.replace("/", "_").replace("\\", "_")

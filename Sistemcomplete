def menu_principal():
    print("\n================================")
    print(" SISTEMA BIOMÉTRICO UNIFICADO ")
    print("================================")
    print("# = ACCESO EN VENTANA 1")
    print("VENTANA 2 = REGISTROS Y VIGILANCIA INDEPENDIENTE")
    print("Ctrl+C = SALIR")
    ventana1_mostrar_accesos("LISTO", "Presiona # para iniciar")
    ventana2_mostrar_registros_etapa2("Menu principal")


def flujo_principal():
    global ventana2_click_opcion

    while True:

        menu_principal()
        ultimo_refresco_ventana1 = 0
        opcion_registro_directa = None

        print("\nEsperando # para acceso. Ventana 2 se controla aparte...")

        while True:

            etapa2_mostrar_ventana_en_menu()

            tecla = leer_tecla()

            if tecla is not None:
                print("TECLA:", tecla)

                if tecla == "#":
                    ventana2_click_opcion = None
                    ventana1_mostrar_accesos("PROCESO", "Iniciando acceso")
                    modo = "acceso"
                    break

            if ventana2_click_opcion is not None:
                opcion_registro_directa = str(ventana2_click_opcion)
                ventana2_click_opcion = None
                ventana2_mostrar_registros_etapa2("Opcion seleccionada")
                modo = "registro"
                break

            if time.time() - ultimo_refresco_ventana1 >= VENTANA1_INTERVALO_REFRESCO:
                ventana1_mostrar_accesos("LISTO", "Presiona # para iniciar")
                ultimo_refresco_ventana1 = time.time()

            time.sleep(0.05)

        if modo == "registro":
            resultado = menu_registro(opcion_registro_directa)
            if resultado == VENTANA2_SOLICITAR_ACCESO:
                flujo_acceso()

        elif modo == "acceso":
            flujo_acceso()


def main():
    asegurar_estructura()
    print(f"VERSION SISTEMA: {VERSION_SISTEMA}")
    registrar_evento("SISTEMA INICIADO")
    etapa3_iniciar_relevadores()
    iniciar_vista_camara_etapa1()
    iniciar_etapa2_en_segundo_plano()

    try:
        flujo_principal()
    except KeyboardInterrupt:
        registrar_evento("SISTEMA FINALIZADO POR EL USUARIO")
    finally:
        detener_vista_camara_etapa1()
        detener_etapa2()
        etapa3_apagar_relevadores()

        try:
            led_apagado()
        except Exception:
            pass

        try:
            cv2.destroyAllWindows()
        except Exception:
            pass

        try:
            lgpio.gpiochip_close(h_gpio)
        except Exception:
            pass


if __name__ == "__main__":
    main()

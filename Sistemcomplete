def ventana2_pedir_texto(titulo, lineas=None, valor_inicial="", valor_si_vacio=None):
    texto = str(valor_inicial or "")
    redibujar = True
    while True:
        if redibujar:
            visibles = list(lineas or [])
            visibles += ["", f"> {texto or '_'}"]
            _mostrar_panel_ventana2(
                titulo,
                visibles,
                pie="Escribe, Enter confirma, Esc cancela",
            )
            redibujar = False

        tecla = _esperar_tecla_ventana2()
        if tecla is None:
            continue
        if tecla == "*":
            return None
        if tecla == "#":
            return texto.strip() or valor_si_vacio
        if tecla == "BORRAR":
            texto = texto[:-1]
            redibujar = True
            continue
        caracter = limpiar_caracter_ventana2(tecla)
        if caracter is not None and len(texto) < 24:
            texto += caracter
            redibujar = True



        registrar_evento(f"ERROR SENSOR HUELLA: {e}")
        return None

    try:
        finger_local.set_led(2, 3, 0, 0)
    except Exception:
        pass

    nuevo_id = obtener_id_huella_libre(finger_local)
    if nuevo_id is None:
        print("\nNo hay IDs libres en el sensor.")
        registrar_evento("NO HAY IDS LIBRES EN SENSOR")
        return None

    print("\n================================")
    print(" REGISTRO DE HUELLA ")
    print("================================")
    print(f"Se usará el ID: {nuevo_id}")
    print("Coloca el dedo...")

    while True:
        estado = finger_local.get_image()
        if estado == adafruit_fingerprint.OK:
            try:
                finger_local.set_led(2, 3, 0, 0)
            except Exception:
                pass
            break
        time.sleep(0.1)

    print("Imagen capturada")

    if finger_local.image_2_tz(1) != adafruit_fingerprint.OK:
        print("Error convirtiendo la primera imagen.")
        registrar_evento("ERROR EN PRIMER TEMPLATE DE HUELLA")
        try:
            finger_local.set_led(1, 3, 0, 0)
            time.sleep(TIEMPO_LED_RECHAZO)
        except Exception:
            pass
        return None

    print("Retira el dedo...")
    while finger_local.get_image() != adafruit_fingerprint.NOFINGER:
        time.sleep(0.1)

    time.sleep(0.8)
    print("Coloca el MISMO dedo nuevamente...")

    while finger_local.get_image() != adafruit_fingerprint.OK:
        time.sleep(0.1)

    print("Segunda imagen capturada")

    if finger_local.image_2_tz(2) != adafruit_fingerprint.OK:
        print("Error convirtiendo la segunda imagen.")
        registrar_evento("ERROR EN SEGUNDO TEMPLATE DE HUELLA")
        try:
            finger_local.set_led(1, 3, 0, 0)
            time.sleep(TIEMPO_LED_RECHAZO)
        except Exception:
            pass
        return None

    if finger_local.create_model() != adafruit_fingerprint.OK:
        print("Las huellas no coinciden.")
        registrar_evento("HUELLAS NO COINCIDEN")
        try:
            finger_local.set_led(1, 3, 0, 0)
            time.sleep(TIEMPO_LED_RECHAZO)
        except Exception:
            pass
        return None

    if finger_local.store_model(nuevo_id) != adafruit_fingerprint.OK:
        print("Error guardando la huella en el sensor.")
        registrar_evento("ERROR AL GUARDAR HUELLA EN SENSOR")
        try:
            finger_local.set_led(1, 3, 0, 0)
            time.sleep(TIEMPO_LED_RECHAZO)
        except Exception:
            pass
        return None

    print("\n================================")
    print(" HUELLA REGISTRADA ")
    print(f" ID: {nuevo_id}")
    print("================================")
    registrar_evento(f"HUELLA REGISTRADA ID={nuevo_id}")

    try:
        finger_local.set_led(3, 3, 0, 0)
        time.sleep(TIEMPO_LED_ACEPTACION)
    except Exception:
        pass

    try:
        finger_local.set_led(1, 4, 0, 0)
    except Exception:
        pass

    return nuevo_id


def eliminar_huella_por_id(fingerprint_id):
    if fingerprint_id in (None, "", 0):
        return True

    finger_local = None
    try:
        finger_local = crear_sensor_huella()
        res = finger_local.delete_model(int(fingerprint_id))
        if res == adafruit_fingerprint.OK:
            print(f"Huella ID {fingerprint_id} eliminada del sensor.")
            registrar_evento(f"HUELLA ELIMINADA ID={fingerprint_id}")
            return True
        print(f"No se pudo eliminar la huella ID {fingerprint_id}.")
        registrar_evento(f"NO SE PUDO ELIMINAR HUELLA ID={fingerprint_id}")
        return False
    except Exception as e:
        print(f"No fue posible eliminar la huella ID {fingerprint_id}: {e}")
        registrar_evento(f"ERROR ELIMINANDO HUELLA ID={fingerprint_id}: {e}")

def etapa2_ejecutar():
    global etapa2_frame_vista

    sensor_afuera = None
    sensor_adentro = None
    pir = None
    camara = None

    try:
        asegurar_archivos_etapa1()
        os.makedirs(ETAPA2_CARPETA_EVIDENCIAS, exist_ok=True)

        sensor_afuera = DigitalInputDevice(
            ETAPA2_GPIO_SENSOR_AFUERA,
            pull_up=True,
            bounce_time=0.1,
        )
        sensor_adentro = DigitalInputDevice(
            ETAPA2_GPIO_SENSOR_ADENTRO,
            pull_up=True,
            bounce_time=0.1,
        )
        pir = MotionSensor(ETAPA2_PIR_GPIO)

        sensor_afuera.when_activated = lambda: etapa2_registrar_sensor("AFUERA")
        sensor_adentro.when_activated = lambda: etapa2_registrar_sensor("ADENTRO")

        camara = etapa2_abrir_camara()
        camara.configure(
            camara.create_video_configuration(
                main={"size": CAMERA_SIZE, "format": "RGB888"},
            )
        )
        camara.start()
        time.sleep(2)

        frame_anterior = None

        registrar_evento_silencioso("ETAPA 2 INICIADA EN SEGUNDO PLANO")

        while not etapa2_detener_evento.is_set():
            frame = camara.capture_array()
            movimiento_camara, frame_anterior = etapa2_detectar_movimiento_camara(
                frame,
                frame_anterior,
            )
            if not ventana2_registro_activo.is_set():
                etapa2_reconocer_rostro_vigilancia(frame)

            datos = etapa2_obtener_estado()
            sin_personas_dentro = int(datos.get("personas_dentro", 0) or 0) == 0
            sin_acceso_pendiente = int(datos.get("permisos_pendientes", 0) or 0) == 0
            vigilancia_armada = sin_personas_dentro and sin_acceso_pendiente

            origenes_alerta = []
            if vigilancia_armada and pir.motion_detected:
                origenes_alerta.append("pir")

            if movimiento_camara and vigilancia_armada:
                origenes_alerta.append("camara")

            if origenes_alerta:
                etapa2_registrar_alerta_vigilancia(
                    frame,
                    origenes_alerta,
                    cuarto_vacio=vigilancia_armada
                )

            if ETAPA2_MOSTRAR_VENTANA:
                frame_vista = frame.copy()
                etapa2_dibujar_estado(frame_vista, movimiento_camara, vigilancia_armada)
                with etapa2_lock:
                    etapa2_frame_vista = cv2.cvtColor(frame_vista, cv2.COLOR_RGB2BGR)

            time.sleep(0.03)

    except Exception as e:
        registrar_evento(f"ERROR ETAPA 2: {e}")
        print(f"ERROR ETAPA 2: {e}")
    finally:
        if camara is not None:
            try:
                camara.stop()
                camara.close()
            except Exception:
                pass

        for sensor in (sensor_afuera, sensor_adentro, pir):
            if sensor is None:
                continue
            try:
                sensor.close()
            except Exception:
                pass

        registrar_evento_silencioso("ETAPA 2 DETENIDA")


def iniciar_etapa2_en_segundo_plano():
    global etapa2_hilo

    if etapa2_hilo is not None and etapa2_hilo.is_alive():
        return etapa2_hilo

    etapa2_detener_evento.clear()
    etapa2_hilo = Thread(target=etapa2_ejecutar, name="Etapa2Aforo", daemon=True)
    etapa2_hilo.start()
    return etapa2_hilo


def detener_etapa2():
    etapa2_detener_evento.set()
    if etapa2_hilo is not None and etapa2_hilo.is_alive():
        etapa2_hilo.join(timeout=5)


def etapa2_mostrar_ventana_en_menu():
    global etapa2_ventana_visible
    global ventana2_click_opcion

    if (
        not ETAPA2_MOSTRAR_VENTANA
        or etapa1_ventana_activa.is_set()
        or ventana2_registro_activo.is_set()
    ):
        return

    frame = _base_etapa2_para_display()
    frame = _componer_ventana2(frame, mensaje="Menu por click/touch")

    if not etapa2_ventana_visible:
        try:
            _configurar_ventana(
                VENTANA_ETAPA2,
                frame.shape[1],
                frame.shape[0],
                VENTANA_ETAPA2_POS,
                VENTANA2_FULLSCREEN,
            )
            etapa2_ventana_visible = True
        except Exception as e:
            registrar_evento(f"ERROR CREANDO VENTANA ETAPA 2: {e}")
            return

    if not VENTANA2_FULLSCREEN:
        cv2.resizeWindow(VENTANA_ETAPA2, frame.shape[1], frame.shape[0])
    cv2.imshow(VENTANA_ETAPA2, frame)
    tecla = cv2.waitKey(1) & 0xFF

    if tecla in (ord("p"), ord("P")):
        etapa2_registrar_permiso_manual()
    elif tecla in tuple(ord(str(n)) for n in range(10)):
        numero = chr(tecla)
        ventana2_click_opcion = 10 if numero == "0" else int(numero)


def etapa2_cerrar_ventana():
    global etapa2_ventana_visible

    if not etapa2_ventana_visible:
        return

    try:
        cv2.destroyWindow(VENTANA_ETAPA2)
        cv2.waitKey(1)
    except Exception:
        pass

    etapa2_ventana_visible = False



def etapa2_actualizar_permiso_visible(
    vence_epoch=None,
    usuario=None,
    cantidad=1,
    sumar_hoy=False,
):
    global etapa2_permiso_visible_hasta
    global etapa2_permiso_visible_usuario
    global etapa2_permisos_consumibles_memoria
    global etapa2_permisos_otorgados_hoy_memoria
    global etapa2_permisos_otorgados_fecha_memoria

    try:
        vence = float(vence_epoch or 0)
    except Exception:
        vence = 0

    if vence <= time.time():
        vence = time.time() + TIEMPO_PERMISO_ETAPA1

    with etapa2_lock:
        etapa2_permiso_visible_hasta = max(etapa2_permiso_visible_hasta, vence)
        if usuario:
            etapa2_permiso_visible_usuario = usuario
        if sumar_hoy:
            etapa2_permisos_consumibles_memoria += max(1, int(cantidad or 1))
        if sumar_hoy:
            fecha_hoy = datetime.now().strftime("%Y-%m-%d")
            if etapa2_permisos_otorgados_fecha_memoria != fecha_hoy:
                etapa2_permisos_otorgados_fecha_memoria = fecha_hoy
                etapa2_permisos_otorgados_hoy_memoria = 0
            etapa2_permisos_otorgados_hoy_memoria += max(1, int(cantidad or 1))



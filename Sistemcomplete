def flujo_acceso():
    """
    Flujo:
        huella -> rostro -> password
    """
    ventana1_limpiar_rostro()
    ventana1_mostrar_accesos("PROCESO", "Validando acceso")
    usuarios = cargar_usuarios()
    if not usuarios:
        print("No hay usuarios registrados.")
        registrar_evento("INTENTO DE ACCESO SIN USUARIOS")
        ventana1_mostrar_accesos("DENEGADO", "No hay usuarios registrados")
        return False

    config = cargar_configuracion()
    password_usuario = config.get("password_usuario", DEFAULT_PASSWORD_USUARIO)
    password_admin = config.get("password_admin", DEFAULT_PASSWORD_ADMIN)

    if not os.path.exists(MODELO_FILE):
        print("No existe el modelo LBPH. Primero debes registrar y entrenar.")
        registrar_evento("INTENTO DE ACCESO SIN MODELO LBPH")
        ventana1_mostrar_accesos("DENEGADO", "Modelo facial no existe")
        return False

    mapa_rostros = cargar_mapa_rostros()

    try:
        modelo = cargar_modelo_lbph()
    except Exception as e:
        print(f"No se pudo cargar el modelo: {e}")
        registrar_evento(f"ERROR CARGANDO MODELO EN ACCESO: {e}")
        ventana1_mostrar_accesos("DENEGADO", "Error cargando modelo")
        return False

    clasificador = cv2.CascadeClassifier(
        cv2.data.haarcascades + "haarcascade_frontalface_default.xml"
    )

    picam2 = None
    intentos = 0
    sistema_bloqueado = False

    try:
        while True:
            if sistema_bloqueado:
                print("========================")
                print(" SISTEMA BLOQUEADO ")
                print("========================")
                print("VERIFICANDO ADMIN...")
                ventana1_mostrar_accesos("PROCESO", "Sistema bloqueado: admin")

                info_huella = verificar_huella()
                if info_huella is None:
                    acceso_denegado("HUELLA ADMIN")
                    guardar_evidencia(picam2, "ADMIN_HUELLA")
                    continue

                nombre_h, datos_h = obtener_usuario_por_huella_id(usuarios, info_huella)
                if nombre_h is None or datos_h is None:
                    acceso_denegado("ADMIN NO REGISTRADO")
                    guardar_evidencia(picam2, "ADMIN_NO_REGISTRADO")
                    continue

                if not datos_h.get("activo", True):
                    acceso_denegado("ADMIN INACTIVO")
                    guardar_evidencia(picam2, "ADMIN_INACTIVO")
                    continue

                if datos_h.get("tipo", "usuario") != "admin":
                    acceso_denegado("USUARIO NO ES ADMIN")
                    guardar_evidencia(picam2, "NO_ADMIN")
                    continue

                ventana1_mostrar_accesos("PROCESO", "Mira a la camara")
                info_rostro = verificar_rostro_con_camara(clasificador, modelo, mapa_rostros)
                if info_rostro is None:
                    acceso_denegado("ROSTRO ADMIN")
                    continue

                nombre_r, datos_r = obtener_usuario_por_rostro_id(usuarios, info_rostro["id"], mapa_rostros)
                if nombre_r is None or datos_r is None:
                    acceso_denegado("ROSTRO ADMIN NO REGISTRADO")
                    guardar_evidencia(picam2, "ADMIN_ROSTRO")
                    continue

                if normalizar_nombre(nombre_h) != normalizar_nombre(nombre_r):
                    acceso_denegado("ADMIN NO COINCIDE")
                    guardar_evidencia(picam2, "ADMIN_NO_COINCIDE")
                    continue

                print("========================")
                print(" INGRESA PASSWORD ADMIN ")
                print("========================")
                ventana1_mostrar_accesos("PROCESO", f"{normalizar_nombre(nombre_h)[:10]} ADMIN")
                password_ingresada = pedir_password("admin", nombre_h)

                if password_ingresada == password_admin:
                    registrar_evento(f"DESBLOQUEO ADMIN CORRECTO: {nombre_h}")
                    print("========================")
                    print(" SISTEMA DESBLOQUEADO ")
                    print("========================")
                    sistema_bloqueado = False
                    intentos = 0
                else:
                    registrar_evento("ADMIN INCORRECTO")
                    acceso_denegado("ADMIN")
                    guardar_evidencia(picam2, "ADMIN_PASSWORD")
                continue

            print("\n================================")
            print(" ACCESO BIOMÉTRICO ")
            print("================================")
            ventana1_mostrar_accesos("PROCESO", "Coloca huella")

            id_huella = verificar_huella()
            if id_huella is None:
                acceso_denegado("HUELLA")
                guardar_evidencia(picam2, "HUELLA")
                continue

            nombre_huella, datos_huella = obtener_usuario_por_huella_id(usuarios, id_huella)

            if nombre_huella is None or datos_huella is None:
                registrar_evento(f"HUELLA SIN USUARIO ASIGNADO ID={id_huella}")
                acceso_denegado("HUELLA NO ASIGNADA")
                guardar_evidencia(picam2, "HUELLA_SIN_USUARIO")
                continue

            if not datos_huella.get("activo", True):
                registrar_evento(f"USUARIO INACTIVO EN HUELLA: {nombre_huella}")
                acceso_denegado("USUARIO INACTIVO")
                guardar_evidencia(picam2, "USUARIO_INACTIVO")
                continue

            ventana1_mostrar_accesos("PROCESO", "Mira a la camara")
            info_rostro = verificar_rostro_con_camara(clasificador, modelo, mapa_rostros)
            if info_rostro is None:
                acceso_denegado("ROSTRO")
                guardar_evidencia(picam2, "ROSTRO")
                continue

            nombre_rostro, datos_rostro = obtener_usuario_por_rostro_id(
                usuarios,
                info_rostro["id"],
                mapa_rostros
            )

            if nombre_rostro is None or datos_rostro is None:
                registrar_evento(f"ROSTRO SIN USUARIO ASIGNADO ID={info_rostro['id']}")
                acceso_denegado("ROSTRO NO ASIGNADO")
                guardar_evidencia(picam2, "ROSTRO_SIN_USUARIO")
                continue

            if not datos_rostro.get("activo", True):
                registrar_evento(f"USUARIO INACTIVO EN ROSTRO: {nombre_rostro}")
                acceso_denegado("USUARIO INACTIVO")
                guardar_evidencia(picam2, "USUARIO_INACTIVO_ROSTRO")
                continue

            if normalizar_nombre(nombre_huella) != normalizar_nombre(nombre_rostro):
                registrar_evento(
                    f"NO COINCIDEN HUELLA Y ROSTRO: {nombre_huella} != {nombre_rostro}"
                )
                acceso_denegado("NO COINCIDEN")
                guardar_evidencia(picam2, "NO_COINCIDEN")
                continue

            tipo_cuenta = str(datos_huella.get("tipo", "usuario")).strip().lower()
            es_admin = tipo_cuenta == "admin"
            etiqueta_password = "admin" if es_admin else "usuario"
            password_esperada = password_admin if es_admin else password_usuario

            print("========================")
            print(f" INGRESA PASSWORD {etiqueta_password.upper()} ")
            print(f" USUARIO: {normalizar_nombre(nombre_huella)} ({etiqueta_password.upper()})")
            print("========================")
            ventana1_mostrar_accesos(
                "PROCESO",
                f"{normalizar_nombre(nombre_huella)[:10]} {etiqueta_password.upper()}",
                usar_ultimo_rostro=True,
            )

            while True:
                password = pedir_password(etiqueta_password, nombre_huella)

                if password is None:
                    intentos += 1
                    registrar_evento(
                        f"PASSWORD INVALIDA INTENTO {intentos}/{MAX_INTENTOS_PASSWORD}"
                    )
                    acceso_denegado("PASSWORD")
                    guardar_evidencia(picam2, "PASSWORD")

                    if intentos >= MAX_INTENTOS_PASSWORD:
                        sistema_bloqueado = True
                        registrar_evento("SISTEMA BLOQUEADO POR EXCESO DE INTENTOS")
                    break

                if password == password_esperada:
                    registrar_evento(
                        f"ACCESO {etiqueta_password.upper()} CORRECTO: {nombre_huella} | "
                        f"HUELLA {id_huella} | ROSTRO {info_rostro['id']}"
                    )
                    conteo = registrar_entrada(nombre_huella)
                    acceso_autorizado(conteo)
                    intentos = 0
                    return True

                else:
                    intentos += 1
                    registrar_evento(
                        f"PASSWORD INCORRECTA INTENTO {intentos}/{MAX_INTENTOS_PASSWORD}"
                    )
                    acceso_denegado("PASSWORD")
                    guardar_evidencia(picam2, "PASSWORD")

                    if intentos >= MAX_INTENTOS_PASSWORD:
                        sistema_bloqueado = True
                        registrar_evento("SISTEMA BLOQUEADO POR EXCESO DE INTENTOS")
                    break

    finally:
        cerrar_camara(picam2)


